#!/bin/sh
# Google Chrome'un resmi .deb paketini Google'dan indirip /opt/tarayici içine açar.
R=/opt/tarayici
URL="https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb"
D="$R/opt/.chrome-indir"
rm -rf "$D" && mkdir -p "$D"
echo "Google Chrome indiriliyor (dl.google.com)..."
if ! curl -fL --retry 3 --connect-timeout 20 ${AXPKG_PROGRESS:+--progress-bar} -o "$D/chrome.deb" "$URL"; then
    echo "HATA: Chrome indirilemedi. İnternet bağlantısını denetleyin: ag test" >&2
    rm -rf "$D"; exit 1
fi
echo "Paket açılıyor..."
rm -rf "$R/opt/google/chrome"
# Doğrudan / içine açmak chroot'taki dizinlerin izinlerini değiştirir; ayrı dizine açıp
# yalnızca /opt/google'ı taşı.
if ! chroot "$R" dpkg-deb -x /opt/.chrome-indir/chrome.deb /opt/.chrome-indir/ac \
    || [ ! -x "$D/ac/opt/google/chrome/chrome" ]; then
    echo "HATA: paket açılamadı" >&2; rm -rf "$D"; exit 1
fi
mkdir -p "$R/opt/google"
mv "$D/ac/opt/google/chrome" "$R/opt/google/chrome"
rm -rf "$D"
# korumalı alan yardımcısı (setuid gerekmez; kullanıcı ad alanları kullanılır)
V=$(chroot "$R" /opt/google/chrome/chrome --version 2>/dev/null)
echo "${V:-Google Chrome} kuruldu. Başlatmak için: google-chrome (ya da Market'te Aç)"
