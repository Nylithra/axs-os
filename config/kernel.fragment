# AxsOS kernel config fragment.
# Applied on top of `make tinyconfig`, then resolved with `make olddefconfig`.

# --- Architecture ---
CONFIG_64BIT=y
CONFIG_SMP=y

# --- Core ---
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_POSIX_TIMERS=y
CONFIG_KALLSYMS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y

# --- Executables ---
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# --- initramfs ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# --- Filesystems ---
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- Console: serial (QEMU -nographic) ---
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# --- Console: VGA text (for ISO boot on a screen) ---
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VGA_CONSOLE=y

# --- Bus / misc ---
CONFIG_PCI=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y

# --- Güç yönetimi (poweroff/reboot) ---
CONFIG_ACPI=y

# --- Ağ (QEMU e1000 / virtio-net, DHCP) ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y

# --- Python/Axs için ---
CONFIG_FILE_LOCKING=y
CONFIG_AIO=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_PROC_SYSCTL=y

# --- Klavye / fare (ISO ekranda açıldığında) ---
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y

# --- UEFI ile açılış (ISO) ---
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# --- Grafik (AxsDE masaüstü): QEMU std VGA (bochs), VESA (BIOS), EFI fb ---
CONFIG_DRM=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FB_VESA=y

# --- Giriş: evdev, PS/2 fare, virtio klavye/tablet (mutlak fare) ---
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_VIRTIO_INPUT=y

# --- Gerçek donanım / sanal makine ağ kartları ---
# Intel (e1000 QEMU/VirtualBox/VMware, e1000e/igb/igc gerçek kartlar), Realtek (r8169, 8139),
# AMD PCnet (VirtualBox), VMware vmxnet3, virtio (QEMU/KVM)
CONFIG_PCI_MSI=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y
CONFIG_8139CP=y
CONFIG_8139TOO=y
CONFIG_NET_VENDOR_AMD=y
CONFIG_PCNET32=y
CONFIG_VMXNET3=y
CONFIG_FW_LOADER=y
CONFIG_IPV6=y

# --- glibc programları ve tarayıcılar (Firefox/Chrome) için ---
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_INOTIFY_USER=y
CONFIG_FHANDLE=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_KCMP=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_SHMEM=y
CONFIG_MEMFD_CREATE=y

# --- Gerçek bilgisayarda USB klavye/fare ---
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
